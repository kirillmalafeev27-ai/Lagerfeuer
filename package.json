{
  "name": "bonfires",
  "private": true,
  "version": "1.0.0",
  "description": "Костры до рассвета (Bis zum Morgengrauen) — игра серии с вопросами по немецкому",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr server/index.ts --outDir dist-server --emptyOutDir",
    "start": "node dist-server/index.js",
    "start:northflank": "node dist-server/index.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "sim": "node --experimental-strip-types --no-warnings tools/sim.ts",
    "shots": "node tools/shots.mjs",
    "test:dark": "node tools/darkTest.mjs",
    "test:e2e": "node tools/e2e.mjs",
    "test:quiz": "node tools/quizE2e.mjs"
  },
  "dependencies": {
    "@fontsource/rubik": "5.3.0",
    "@fontsource/rubik-scribble": "5.3.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
